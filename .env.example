# Must match backend APP_PORT in SuperviseSuite-Backend/.env
# Keep host consistent (localhost with localhost).
VITE_API_BASE_URL=http://localhost:8081

# GitHub modal page size (activity/contributors).
# Keep aligned with backend limits.
VITE_GITHUB_PAGE_SIZE=10

# Optional GitHub App installation entrypoint used by supervisor overview card.
# Example: https://github.com/apps/<your-app-slug>/installations/new
VITE_GITHUB_APP_INSTALL_URL=
